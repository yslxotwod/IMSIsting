# ── runtime: never commit captured material, results or scratch ─────────
# loot/ holds unredacted identities and captures; captures/ holds raw pcap and
# IQ; logs/ holds session logs; state/ and tmp/ are scratch.
/loot/
/captures/
/logs/
/state/
/cases/
/tmp/
# /docs holds generated reference material; the hand-written manual under
# docs/manual/ and the GitHub Pages site are source and are tracked, so the
# rule ignores the directory's contents rather than the directory itself.
/docs/*
!/docs/manual/
!/docs/index.html
!/docs/style.css
!/docs/splash.js
!/docs/imsisting-desktop.png
!/docs/imsisting-icon.png
!/docs/imsisting_screenshot.png
!/docs/imsisting_screenshot2.png
!/docs/imsisting_splash.png
!/docs/imsisting_splash*.mp4
!/docs/splash*-poster.jpg
!/docs/modules.html
!/docs/modules.css
!/docs/module-icons/
!/docs/install.html
!/docs/install.css
!/docs/glow-dust.js
!/docs/documentation.html
!/docs/documentation.css
!/docs/documentation/

# AGENTS.md is a briefing for whoever works in the tree, not part of the
# project: it must never be committed or pushed (its own rule zero).
/AGENTS.md

# ── build output ────────────────────────────────────────────────────────
/native/builddir/
# release archives are cut by tools/make-tarball.sh beside the tree, not source
/IMSIsting-*.tar.gz
*.o
*.obj
__pycache__/
*.py[cod]

# ── editor / OS ─────────────────────────────────────────────────────────
*.swp
*.swo
*~
.DS_Store
# cscope/ctags-style function-name scratch, e.g. native/src/main1.c.fns
*.fns

# ── local session logs and diagnostics ──────────────────────────────────
session_*.log
gui.stderr

# Kate leaves its swap beside the file, named *.kate-swp
*.kate-swp

# Local working state for the skills deck, not source.
/.dsh-mattskillsdeck-cache/
# ── generated reference data ──────────────────────────────────────────
# The tables under public/ are downloaded and regenerated by
# tools/fetch-reference-data.sh; they are reproducible from their sources,
# so they are not tracked. data/opops/ is the private, user-supplied half
# (see docs/manual/part5-techniques.md 5.6.4) and is never committed either.
# The editable templates (*.dist) ARE tracked: they carry the schema and the
# example rows, never a real operator's numbers.
#
# The pattern is `/data/*` and not `/data/**` on purpose: git cannot re-include
# a file whose parent directory is excluded, so `!` against `/data/**` silently
# does nothing and the templates vanish.
/data/*
!/data/.gitkeep
!/data/opops/
/data/opops/*
!/data/opops/*.dist
